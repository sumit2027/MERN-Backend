<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRUD EJS</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">
         <div class="nav mb-10">
            <a class="text-blue-500" href="/read">Read Users</a>
        </div>
        <h1 class="text-3xl tracking-tighter mb-3">Update User</h1>
        <!-- <hr> -->
        <form action="/update/<%= user._id %>" method="post">
            <input class="px-5 py-2 border-2 border-zinc-800 rounded-lg bg-transparent outline-none" type="text" name="name" placeholder="Name" value="<%= user.name %>">
            <input class="px-5 py-2 border-2 border-zinc-800 rounded-lg bg-transparent outline-none" type="text" name="email" placeholder="Email" value="<%= user.email %>">
            <input class="px-5 py-2 border-2 border-zinc-800 rounded-lg bg-transparent outline-none" type="text" name="image" placeholder="Image url" value="<%= user.image %>">
            <input class="px-5 py-2 bg-yellow-500 ml-3 rounded-lg text-black" type="submit" value="Update User">
        </form>
    </div>
    <script src="/javascripts/script.js"></script>
</body>
</html>